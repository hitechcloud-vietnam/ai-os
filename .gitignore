# ═══════════════════════════════════════════════════════════════
#  HiTechCloud AI OS — .gitignore (SaaS Standard)
# ═══════════════════════════════════════════════════════════════

# Rust
/target/
**/*.rs.bk

# Go
/bin/
/services/*/bin
/services/*/vendor/

# Logs & PIDs
/logs/*.log
/pids/*.pid
*.log

# Environment (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
.env.*.local
configs/*.local.toml
configs/secrets/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.exe

# Test & Coverage
coverage/
*.profraw
*.profdata

# Temporary files
tmp/
temp/
*.tmp
*.dylib
